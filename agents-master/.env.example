# ============================================================
# ContextBridge Agent 环境变量示例
# 复制本文件为 .env 后填入真实值（.env 勿提交 Git）
#   - 模型 Key 三选一即可：DashScope（国内推荐）/ Anthropic / OpenAI
#   - 高德 Key：旅行模式必填
#   - LangSmith：可选，留空则不开启追踪
# ============================================================

# ---------- 模型 API（至少配置一个） ----------
# 阿里云百炼 DashScope（OpenAI 兼容接口），国内推荐
# 北京: https://dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic（可选，配置后侧边栏可选 Claude 模型）
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# OpenAI（可选；配置后侧边栏可选 GPT 模型，rag-server Embedding 也用它）
OPENAI_API_KEY=sk-proj-xxxxxxxx

# ---------- 高德地图（旅行模式必填） ----------
# 高德开放平台申请 Web 服务 Key，否则天气/路线接口会报 USERKEY_PLAT_NOMATCH
AMAP_MAPS_API_KEY=your_amap_key_here

# ---------- 联网搜索（联网问答必填） ----------
# 博查 AI 开放平台 https://open.bochaai.com 申请 API Key
BOCHA_API_KEY=your_bocha_key_here
# 网页正文抓取方式：direct=直接抓原站（默认）；jina=经 r.jina.ai 提取正文
WEB_FETCH_MODE=direct

# ---------- LangSmith 追踪（可选） ----------
# 在 https://smith.langchain.com → Settings → API Keys 创建 Key
#   lsv2_sk_ 开头 = Service Key（组织级，必须填 LANGSMITH_WORKSPACE_ID）
#   lsv2_pt_ 开头 = Personal Token（自带默认工作区，无需 WORKSPACE_ID）
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agents-master
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# ---------- 应用登录（可选） ----------
# 置为 true 后，启动应用需输入下方账号密码
USE_LOGIN=false
USER_ID=admin
USER_PASSWORD=change_me
